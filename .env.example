# ============================================================
# darkweb-exposure-toolkit — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is in .gitignore.
# ============================================================

# --- HaveIBeenPwned API Key ---
# This tool is FREE. The HIBP API key costs $3.50/month from haveibeenpwned.com/API/Key
# Optional — without it, HIBP checks are skipped but all other sources still run.
# Without any API keys the tool still checks: LeakCheck, BreachDirectory, Emailrep, psbdmp
HIBP_API_KEY=your_hibp_api_key_here

# --- GitHub Personal Access Token (free) ---
# Create at: GitHub Settings → Developer Settings → Personal Access Tokens
# Required scope: public_repo (read-only)
# Without this, GitHub search is rate-limited to 10 requests/hour.
GITHUB_TOKEN=your_github_token_here

# --- Emailrep.io API Key (free) ---
# Get yours at: https://emailrep.io/key
# Optional — works without a key at a reduced rate limit.
EMAILREP_API_KEY=your_emailrep_key_here

# --- OSINTLeak API Key (free starter) ---
# Get yours at: https://osintleak.com
# Optional — required for stealer log and dark web checks.
OSINTLEAK_API_KEY=your_osintleak_key_here

# --- GitGuardian API Key (free, optional) ---
# Used by the ggshield CLI tool for the token/API-key leak check.
# NOT required — the check works anonymously with a smaller daily quota.
# Get your own free key at: https://dashboard.gitguardian.com
# See docs/setup.md for the full ggshield install + setup walkthrough.
GITGUARDIAN_API_KEY=your_gitguardian_key_here

# --- Emails to Check (comma-separated) ---
EMAILS_TO_CHECK=email1@example.com,email2@example.com

# --- Usernames to Check (comma-separated) ---
USERNAMES_TO_CHECK=username1,username2

# --- Phone Numbers to Check (comma-separated, include country code) ---
PHONES_TO_CHECK=+11234567890,+10987654321

# --- Runtime-only checks (DO NOT add here) ---
# Passwords and API tokens are entered at runtime only
# and are never written to disk or stored anywhere.
